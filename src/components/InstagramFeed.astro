---
import { club } from '../data';

interface Props {
  feedUrl: string;
  limit?: number;
}

const { feedUrl, limit = 12 } = Astro.props;
---

<div class="instagram-feed" data-feed-url={feedUrl} data-limit={limit}>
  <ul class="instagram-list" aria-label="Recent Instagram posts" aria-busy="true">
    {Array.from({ length: 2 }, () => <li class="instagram-placeholder" aria-hidden="true"></li>)}
  </ul>
  <p class="instagram-error" hidden>
    Couldn't load our latest posts. See them on <a href={club.instagram} target="_blank" rel="noopener">Instagram</a>.
  </p>
  <p class="instagram-follow">
    <a href={club.instagram} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="4.5" />
        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
      </svg>
      Follow @flyghtultimate on Instagram for more...
    </a>
  </p>
</div>

<script>
  interface BeholdSize {
    width: number;
    height: number;
    mediaUrl: string;
  }

  interface BeholdSizes {
    small: BeholdSize;
    medium: BeholdSize;
    large: BeholdSize;
    full: BeholdSize;
  }

  interface BeholdPost {
    id: string;
    permalink: string;
    mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
    prunedCaption?: string;
    caption?: string;
    timestamp: string;
    sizes: BeholdSizes;
    children?: { id: string; sizes?: BeholdSizes }[];
  }

  const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

  function renderSlide(sizes: BeholdSizes, permalink: string, alt: string): HTMLAnchorElement {
    const { small, medium, large, full } = sizes;
    const link = document.createElement('a');
    link.href = permalink;
    link.target = '_blank';
    link.rel = 'noopener';
    link.className = 'instagram-slide';

    const img = document.createElement('img');
    img.src = large.mediaUrl;
    img.srcset = [small, medium, large, full].map((s) => `${s.mediaUrl} ${s.width}w`).join(', ');
    img.sizes = '(max-width: 600px) 100vw, 560px';
    img.width = large.width;
    img.height = large.height;
    img.loading = 'lazy';
    img.decoding = 'async';
    img.alt = alt;
    link.append(img);
    return link;
  }

  function renderArrow(direction: 'prev' | 'next'): HTMLButtonElement {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `instagram-arrow instagram-arrow-${direction}`;
    button.setAttribute('aria-label', direction === 'prev' ? 'Previous image' : 'Next image');
    button.textContent = direction === 'prev' ? '‹' : '›';
    return button;
  }

  function renderMedia(post: BeholdPost): HTMLDivElement {
    const media = document.createElement('div');
    media.className = 'instagram-media';

    const slides = (post.children ?? []).flatMap((child) => (child.sizes ? [child.sizes] : []));
    if (post.mediaType !== 'CAROUSEL_ALBUM' || slides.length < 2) {
      media.append(renderSlide(post.sizes, post.permalink, 'View this post on Instagram'));
      if (post.mediaType === 'VIDEO') {
        const badge = document.createElement('span');
        badge.className = 'instagram-badge';
        badge.textContent = 'Video';
        media.append(badge);
      }
      return media;
    }

    const track = document.createElement('div');
    track.className = 'instagram-track';
    track.append(
      ...slides.map((sizes, i) =>
        renderSlide(sizes, post.permalink, `Image ${i + 1} of ${slides.length}, view this post on Instagram`),
      ),
    );

    const prev = renderArrow('prev');
    const next = renderArrow('next');
    const counter = document.createElement('span');
    counter.className = 'instagram-badge';

    const update = () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      counter.textContent = `${index + 1} / ${slides.length}`;
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth }));
    next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth }));
    track.addEventListener('scroll', update, { passive: true });
    update();

    media.append(track, prev, next, counter);
    return media;
  }

  function renderPost(post: BeholdPost): HTMLLIElement {
    const caption = (post.prunedCaption ?? post.caption ?? '').trim();

    const item = document.createElement('li');
    const article = document.createElement('article');
    article.className = 'instagram-post';

    const date = document.createElement('time');
    date.className = 'instagram-date';
    date.dateTime = post.timestamp;
    date.textContent = dateFormat.format(new Date(post.timestamp));

    article.append(renderMedia(post), date);

    if (caption) {
      const text = document.createElement('p');
      text.className = 'instagram-caption';
      text.textContent = caption;
      article.append(text);
    }

    item.append(article);
    return item;
  }

  async function loadFeed(container: HTMLElement) {
    const list = container.querySelector<HTMLUListElement>('.instagram-list')!;
    const error = container.querySelector<HTMLParagraphElement>('.instagram-error')!;
    const limit = Number(container.dataset.limit);

    try {
      const res = await fetch(container.dataset.feedUrl!);
      if (!res.ok) {
        throw new Error(`Feed request failed: ${res.status}`);
      }
      const { posts } = (await res.json()) as { posts: BeholdPost[] };
      list.replaceChildren(...posts.slice(0, limit).map(renderPost));
    } catch (err) {
      console.error(err);
      list.hidden = true;
      error.hidden = false;
    } finally {
      list.removeAttribute('aria-busy');
    }
  }

  document.querySelectorAll<HTMLElement>('.instagram-feed').forEach(loadFeed);
</script>

<style>
  .instagram-list {
    list-style: none;
    max-width: 560px;
    margin: 24px auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .instagram-placeholder {
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    background-color: rgba(36, 83, 72, 0.08);
    animation: instagram-pulse 1.4s ease-in-out infinite;
  }

  @keyframes instagram-pulse {
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-placeholder {
      animation: none;
    }
  }

  .instagram-list :global(.instagram-media) {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--dark-green);
  }

  .instagram-list :global(.instagram-track) {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .instagram-list :global(.instagram-track::-webkit-scrollbar) {
    display: none;
  }

  .instagram-list :global(.instagram-slide) {
    display: block;
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  .instagram-list :global(.instagram-slide img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .instagram-list :global(.instagram-slide:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .instagram-list :global(.instagram-arrow) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0 0 4px;
    border: 0;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.9);
    color: var(--black);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(15, 36, 38, 0.3);
    transition: opacity 0.2s ease;
  }

  .instagram-list :global(.instagram-arrow-prev) {
    left: 10px;
  }

  .instagram-list :global(.instagram-arrow-next) {
    right: 10px;
  }

  .instagram-list :global(.instagram-arrow:disabled) {
    opacity: 0;
    pointer-events: none;
  }

  .instagram-list :global(.instagram-arrow:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-list :global(.instagram-track) {
      scroll-behavior: auto;
    }
  }

  .instagram-list :global(.instagram-badge) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: rgba(15, 36, 38, 0.7);
    color: var(--white);
    font-size: 0.75rem;
  }

  .instagram-list :global(.instagram-date) {
    display: block;
    margin-top: 12px;
    color: var(--heading);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .instagram-list :global(.instagram-caption) {
    margin: 4px 0 0;
    white-space: pre-line;
  }

  .instagram-follow {
    text-align: center;
    margin: 8px 0 24px;
  }

  .instagram-follow a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 999px;
    background: linear-gradient(45deg, #feda75, #fa7e1e 25%, #d62976 50%, #962fbf 75%, #4f5bd5);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(214, 41, 118, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .instagram-follow a:hover,
  .instagram-follow a:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(214, 41, 118, 0.4);
  }

  .instagram-follow a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-follow a {
      transition: none;
    }

    .instagram-follow a:hover,
    .instagram-follow a:focus-visible {
      transform: none;
    }
  }
</style>
