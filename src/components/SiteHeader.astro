---
import { Image } from 'astro:assets';
import logo from '../assets/flyght_logo.png';
import { documents, consentForms } from '../data';

const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/what-is-ultimate/', label: 'What is Ultimate' },
  { href: '/news/', label: 'News' },
];
const isCurrent = (href: string) => (currentPath === href ? 'page' : undefined);
---

<header>
  <div class="header-inner">
    <a class="logo-link" href="/">
      <Image src={logo} alt="Flyght Ultimate logo" width={96} height={96} loading="eager" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-label="Open menu">&#9776;</button>

    <nav class="site-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href)}>{link.label}</a>
      ))}

      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" type="button" aria-expanded="false" aria-controls="documents-menu">
          Documents
          <span aria-hidden="true">▾</span>
        </button>

        <div class="dropdown-menu" id="documents-menu">
          <button class="mobile-back-btn" type="button">‹ Back to Main Menu</button>
          <a href="/documents/">All documents</a>
          {documents.map((doc) => (
            <a href={doc.href} target="_blank" rel="noreferrer">{doc.label}</a>
          ))}

          <div class="submenu">
            <button class="submenu-toggle" type="button" aria-expanded="false" aria-controls="consent-forms-menu">
              Consent Forms
              <span aria-hidden="true">▸</span>
            </button>

            <div class="submenu-menu" id="consent-forms-menu">
              <button class="mobile-back-btn" type="button">‹ Back to Documents</button>
              {consentForms.map((form) => (
                <a href={form.href} target="_blank" rel="noreferrer">{form.label}</a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <a href="/contact/" aria-current={isCurrent('/contact/')}>Contact</a>
    </nav>
  </div>
</header>

<style is:global>
  :root { --site-header-height: 64px; }

  /* Sticky header */
  header {
    position: sticky;
    top: 0;
    z-index: 9999;
    width: 100%;
    background: var(--dark-green);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--white);
    overflow: visible;
  }

  /* Header inner layout */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 .75rem;
    min-height: 64px;
  }

  main { padding-top: 20px; transition: padding-top .12s; }

  /* Desktop nav */
  .site-nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    position: relative;
  }
  .site-nav a,
  .nav-dropdown-toggle,
  .submenu-toggle,
  .mobile-back-btn {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .5rem .4rem;
    text-decoration: none;
    color: var(--white);
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .site-nav a:hover,
  .site-nav a:focus,
  .nav-dropdown-toggle:hover,
  .nav-dropdown-toggle:focus,
  .submenu-toggle:hover,
  .submenu-toggle:focus {
    color: #0b62a4;
  }

  .mobile-back-btn { display: none; }

  /* Desktop flyouts */
  @media (min-width: 769px) {
    .nav-dropdown, .submenu { position: relative; }

    .dropdown-menu, .submenu-menu {
      display: none;
      position: absolute;
      background: var(--dark-green);
      box-shadow: 0 12px 24px rgba(0,0,0,.12);
      border: 1px solid rgba(255,255,255,.12);
      z-index: 3000;
      text-align: center;
      min-width: 220px;
    }

    .nav-dropdown.is-open > .dropdown-menu,
    .submenu.is-open > .submenu-menu {
      display: block;
    }

    .dropdown-menu {
      top: calc(100% + .5rem);
      left: 50%;
      transform: translateX(-50%);
    }

    .submenu-menu {
      top: 0;
      left: 100%;
    }

    .dropdown-menu a, .submenu-menu a {
      display: block;
      padding: .7rem .9rem;
      color: var(--white);
      text-decoration: none;
      white-space: nowrap;
    }

    .dropdown-menu a:hover, .submenu-menu a:hover {
      background: rgba(255,255,255,.06);
    }
  }

  /* Nav toggle (hidden on desktop) */
  .nav-toggle { display: none; background: transparent; border: none; font-size: 1.25rem; line-height:1; padding: .5rem; cursor: pointer; color: var(--white); }

  /* Mobile drill-down styles */
  @media (max-width: 768px) {
    .nav-toggle { display: inline-flex; align-items:center; justify-content:center; }

    .site-nav { 
      display: none;
      position: absolute;
      top: var(--site-header-height);
      left: 0;
      right: 0;
      height: calc(100vh - var(--site-header-height));
      background: var(--dark-green);
      overflow-x: hidden;
      overflow-y: auto;
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 0;
    }

    header.mobile-menu-open .site-nav {
      display: flex;
    }

    .site-nav a,
    .nav-dropdown-toggle,
    .submenu-toggle,
    .mobile-back-btn {
      width: 100%;
      justify-content: center;
      padding: .85rem 1rem;
      border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .mobile-back-btn {
      display: flex;
      font-weight: bold;
      background: rgba(255,255,255,.08);
      margin-bottom: .5rem;
    }

    .nav-dropdown, .submenu { width: 100%; }

    /* Drill-down subpanels replace the main menu layer */
    .dropdown-menu,
    .submenu-menu {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--dark-green);
      z-index: 10;
      padding-top: .5rem;
    }

    .dropdown-menu.is-active,
    .submenu-menu.is-active {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector('header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');

  function setHeaderHeightVar() {
    const h = header?.getBoundingClientRect().height || 64;
    document.documentElement.style.setProperty('--site-header-height', Math.ceil(h) + 'px');
  }

  function closeAllSubpanels() {
    document.querySelectorAll('.dropdown-menu, .submenu-menu').forEach((menu) => {
      menu.classList.remove('is-active');
    });
    document.querySelectorAll('.nav-dropdown, .submenu').forEach((container) => {
      container.classList.remove('is-open');
    });
    document.querySelectorAll('.nav-dropdown-toggle, .submenu-toggle').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
  }

  function closeMobileMenu() {
    if (!header || !toggle) {
      return;
    }
    header.classList.remove('mobile-menu-open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    closeAllSubpanels();
    requestAnimationFrame(setHeaderHeightVar);
  }

  setHeaderHeightVar();
  window.addEventListener('load', setHeaderHeightVar);
  window.addEventListener('resize', setHeaderHeightVar);

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = header!.classList.toggle('mobile-menu-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (!open) {
      closeAllSubpanels();
    }
    requestAnimationFrame(setHeaderHeightVar);
  });

  header?.querySelectorAll('.site-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) {
        closeMobileMenu();
      }
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (header?.classList.contains('mobile-menu-open') && !header.contains(target)) {
      closeMobileMenu();
    }
    if (window.innerWidth > 768 && !target.closest('.nav-dropdown, .submenu')) {
      closeAllSubpanels();
    }
  });

  document.querySelectorAll('.nav-dropdown-toggle, .submenu-toggle').forEach((button) => {
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const menu = button.nextElementSibling;
      if (!menu) {
        return;
      }

      if (window.innerWidth <= 768) {
        menu.classList.add('is-active');
      } else {
        const container = button.closest('.nav-dropdown, .submenu')!;
        const isOpen = container.classList.contains('is-open');
        if (container.classList.contains('nav-dropdown')) {
          closeAllSubpanels();
        }
        container.classList.toggle('is-open', !isOpen);
        button.setAttribute('aria-expanded', String(!isOpen));
      }
    });
  });

  document.querySelectorAll('.mobile-back-btn').forEach((button) => {
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      button.closest('.dropdown-menu, .submenu-menu')?.classList.remove('is-active');
    });
  });
</script>
