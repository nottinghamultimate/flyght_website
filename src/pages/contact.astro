---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { club } from '../data';
import team3 from '../assets/images/team_3.jpg';
---

<BaseLayout
  title="Contact Flyght Ultimate | Nottingham Ultimate Frisbee"
  description="Get in touch with Flyght Ultimate in Nottingham via Discord, Instagram or email. Schools and organisations can enquire about coaching sessions and taster events."
>
  <section class="page container">
    <div class="contact-with-image">
      <div class="contact-copy">
        <h1>Contact Us</h1>
        <p>Join our <a href={club.discord} target="_blank" rel="noopener"><strong>Discord</strong></a> - this is the fastest way to reach us and stay up to date.</p>
        <p>Follow us on <a href={club.instagram} target="_blank" rel="noopener"><strong>Instagram</strong></a>.</p>

        <h2>General enquiries</h2>
        <p><a href={`mailto:${club.email}`}>{club.email}</a></p>

        <h2>Schools and organisations</h2>
        <p>Interested in coaching sessions or taster events?</p>
        <p>Email us at <a href={`mailto:${club.email}`}>{club.email}</a>.</p>
      </div>
      <Image
        src={team3}
        alt="Flyght Ultimate members posing together on a beach"
        width={1120}
        widths={[560, 1120]}
        sizes="(max-width: 768px) 100vw, 560px"
      />
    </div>
  </section>
</BaseLayout>
